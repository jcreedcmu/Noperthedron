def cross (u v : Array ℚ) : Array ℚ :=
  #[u[1]! * v[2]! - u[2]! * v[1]!, u[2]! * v[0]! - u[0]! * v[2]!, u[0]! * v[1]! - u[1]! * v[0]!]
def dot (u v : Array ℚ) : ℚ := u[0]! * v[0]! + u[1]! * v[1]! + u[2]! * v[2]!
def sub (u v : Array ℚ) : Array ℚ := #[u[0]! - v[0]!, u[1]! - v[1]!, u[2]! - v[2]!]
def mix (m : ℚ) (u v : Array ℚ) : Array ℚ := #[m * u[0]! + (1 - m) * v[0]!, m * u[1]! + (1 - m) * v[1]!, m * u[2]! + (1 - m) * v[2]!]
-- one "row": 4 axes x 3 contacts x 20 vertices x 3 corners of supportAt, on a
-- sub-triangle (midpoint path of length depth) of the base triangle.
def rowWork (V T : Array (Array ℚ)) (seed depth : Nat) : ℚ := Id.run do
  let mut t := T
  for l in [0:depth] do
    let c := (seed / (l+1)) % 4
    let m01 := #[(t[0]![0]! + t[1]![0]!)/2, (t[0]![1]! + t[1]![1]!)/2, (t[0]![2]! + t[1]![2]!)/2]
    let m12 := #[(t[1]![0]! + t[2]![0]!)/2, (t[1]![1]! + t[2]![1]!)/2, (t[1]![2]! + t[2]![2]!)/2]
    let m20 := #[(t[2]![0]! + t[0]![0]!)/2, (t[2]![1]! + t[0]![1]!)/2, (t[2]![2]! + t[0]![2]!)/2]
    t := if c == 0 then #[t[0]!, m01, m20] else if c == 1 then #[m01, t[1]!, m12] else if c == 2 then #[m20, m12, t[2]!] else #[m01, m12, m20]
  let mut acc : ℚ := 0
  for j in [0:4] do
    for i in [0:3] do
      let a := (seed + 7*j + 3*i) % 20
      let b := (a + 1 + j) % 20
      let e := mix ((((seed + i) % 1000 : Nat) : ℚ) / 1000) (sub V[a]! V[b]!) (sub V[(a+5)%20]! V[(b+5)%20]!)
      let s := V[(a + 2) % 20]!
      for k in [0:20] do
        let cr := cross e (sub V[k]! s)
        for corner in [0:3] do
          let x := dot t[corner]! cr
          if x > acc then acc := x
  return acc

def bench (name : String) (V T : Array (Array ℚ)) (rows : Nat) : IO Unit := do
  let t0 ← IO.monoMsNow
  let mut s : ℚ := 0
  for r in [0:rows] do
    s := s + rowWork V T r 12
  let t1 ← IO.monoMsNow
  IO.println s!"{name}: {rows} rows in {t1 - t0} ms ({(t1 - t0) / rows} ms/row) [checksum bits {s.num.natAbs.log2}]"

def main : IO Unit := do
  bench "current (822-bit corners, 260-bit vertices)" vertsBig trisBig 20
  bench "dyadic (2^-62 corners, 2^-52 vertices)" vertsDy trisDy 20
